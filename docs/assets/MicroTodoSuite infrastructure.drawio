        <mxCell id="note_life" value="&lt;b&gt;Runtime and durable layers.&lt;/b&gt; &lt;i&gt;scripts/aws-profile-lifecycle.sh&lt;/i&gt; brings the runtime — the cluster, nodes, NAT gateways and load balancer — down and back up from reviewed saved plans. The durable layer on the right is never destroyed." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#232F3E;" vertex="1" parent="region">
          <mxGeometry x="20" y="650" width="620" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note_net" value="&lt;b&gt;Ingress:&lt;/b&gt; one shared ALB, created by the AWS Load Balancer Controller, routes by host — prod at eco.microtodosuite.online; dev, staging and demo at &amp;lt;env&amp;gt;.eco.microtodosuite.online.&lt;br&gt;&lt;b&gt;Egress:&lt;/b&gt; private nodes reach the internet through the NAT gateway in their own AZ." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#232F3E;" vertex="1" parent="region">
