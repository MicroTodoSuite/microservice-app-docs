        </mxCell>
        <mxCell id="wl_note" value="Service-to-service traffic runs inside the Istio mesh with STRICT mTLS. No service keeps durable data; Redis is neither persisted nor replicated, which is why production fails over rather than runs active-active." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;" vertex="1" parent="wl">
