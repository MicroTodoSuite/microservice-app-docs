        <mxCell id="v15" value="listeners, load balancers, target groups, orphaned&lt;br&gt;ENIs, security groups, then snapshotted volumes,&lt;br&gt;each revalidated just before deletion" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=8;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#232F3E;" vertex="1" parent="1">
