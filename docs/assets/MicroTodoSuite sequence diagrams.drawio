        <mxCell id="v2" value="No secret value is ever committed. The cluster reads AWS Secrets Manager with an identity bound to the pod's ServiceAccount." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#545B64;" vertex="1" parent="1">
